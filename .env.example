# VITE_API_BASE_URL: Base URL of the Junto backend REST API service.
# Configured for either local development or proxy to remote backend.
VITE_API_BASE_URL="http://localhost:3000/api"

# VITE_JUNTO_API_BASE_URL: Alias for existing backend URL configuration.
VITE_JUNTO_API_BASE_URL="http://localhost:3000/api"

# VITE_GOOGLE_CLIENT_ID: Google OAuth Web Client ID for Google Sign-In.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
