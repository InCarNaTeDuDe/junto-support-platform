# VITE_JUNTO_API_BASE_URL: Base URL of the existing Junto backend REST API service.
# Example: https://api.junto.com or http://localhost:8080/api
VITE_JUNTO_API_BASE_URL="https://api.junto.com"

# VITE_GOOGLE_CLIENT_ID: Optional Google OAuth Web Client ID for Google Sign-In.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
